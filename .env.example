# CampusVibe Environment Variables

# Server
PORT=3000
JWT_SECRET=
# Secret used to sign QR payloads (HMAC-SHA256). If empty, JWT_SECRET is used.
QR_SIGNING_SECRET=

# Admin seed user
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth (add and enable when ready)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback



# SMTP Email (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampusVibe <no-reply@campusvibe.local>"

# SMS Provider
SMS_API_URL=
SMS_API_KEY=

# AI Chatbot (optional) — without this, the floating assistant still works
# using its built-in knowledge base of common questions. Set this to enable
# genuinely open-ended, LLM-generated answers for anything the knowledge
# base doesn't cover.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

